# FundsFlee — environment (single .env.local drives the FastAPI backend AND the
# SPA build). Copy to .env.local and fill in:  cp .env.local.example .env.local
#
# The backend reads this file (../.env.local) via app/config.py. `deploy.sh`
# also surfaces VAPID_PUBLIC_KEY to the SPA build as VITE_VAPID_PUBLIC_KEY.

# ── App origin ───────────────────────────────────────────────────────────────
# Public URL of the deployed app (single origin: API + SPA). No trailing slash.
# Used to build the Google OAuth redirect: <BASE_URL>/auth/google/callback
BASE_URL=https://fundsflee.voidall.com

# ── Google OAuth (Cloud Console → APIs & Services → Credentials) ─────────────
# Register <BASE_URL>/auth/google/callback as an Authorized redirect URI.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# ── Secrets ──────────────────────────────────────────────────────────────────
# Session-cookie (JWT) signing key.  Generate: openssl rand -base64 48
SESSION_SECRET=your-session-secret-here
# iOS Shortcut token signing key — KEEP THE EXISTING VALUE (changing it breaks
# every already-installed Shortcut).  Generate (new installs): openssl rand -base64 48
JWT_SECRET=your-jwt-secret-here

# ── AI provider ──────────────────────────────────────────────────────────────
# "opencode" (default) | "claude" | "gemini" — falls back through the chain.
AI_PROVIDER=opencode
# OpenCode backend (used when AI_PROVIDER=opencode; image features unsupported here)
OPENCODE_API_URL=https://ttt.voidall.com
# OCR space used for receipt images (image → text, then OpenCode)
# OCR_API_URL=https://jebin2-ocr.hf.space
# Sent as X-API-Key to both TTT backends — must match their TTT_API_KEY.
TTT_API_KEY=
# Required only for the matching provider:
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=your-gemini-api-key
# Optional: override the model for the selected provider
# AI_MODEL=claude-sonnet-4-6

# ── Web push (optional) ──────────────────────────────────────────────────────
# Generate a pair:  npx web-push generate-vapid-keys
# The PUBLIC key is auto-wired into the SPA build by deploy.sh (VITE_VAPID_PUBLIC_KEY).
# VAPID_PUBLIC_KEY=your-vapid-public-key
# VAPID_PRIVATE_KEY=your-vapid-private-key

# ── Advanced (defaults are fine) ─────────────────────────────────────────────
# SESSION_COOKIE=fundsflee_session
# CRON_SESSION_FILE=data/cron-session.json      # relative to backend/
# USER_STORE_FILE=data/users.json               # relative to backend/
# FRONTEND_DIST=/abs/path/to/frontend/dist      # default: ../frontend/dist
