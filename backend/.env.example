# FundsFlee backend — production environment.
# Loaded by app/config.py AFTER ../.env.local (so values here override the
# Next.js .env.local during the migration). Copy to backend/.env on the server.

# ── Server ───────────────────────────────────────────────────────────────────
# Public origin of the deployed app (single-origin: API + SPA on the same host).
# MUST match the domain you register as the Google OAuth redirect base.
BASE_URL=https://fundsflee.example.com

# Session cookie signing secret (JWT). If unset, falls back to AUTH_SECRET.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=change-me-to-a-long-random-string
# SESSION_COOKIE=fundsflee_session

# ── Google OAuth ─────────────────────────────────────────────────────────────
# Register https://<BASE_URL>/auth/google/callback as an authorized redirect URI
# in the Google Cloud Console for this client BEFORE deploying.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── iOS Shortcut JWT — KEEP THE EXISTING VALUE ───────────────────────────────
# Changing this breaks every already-installed shortcut. Reuse the deployed one.
JWT_SECRET=

# ── AI providers ─────────────────────────────────────────────────────────────
AI_PROVIDER=opencode
# AI_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENCODE_API_URL=https://opencode.voidall.com

# ── Web push (VAPID) ─────────────────────────────────────────────────────────
# Generate a pair: npx web-push generate-vapid-keys
# The PUBLIC key must ALSO be set as VITE_VAPID_PUBLIC_KEY at frontend build time.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── Paths (relative to backend/ working dir) ─────────────────────────────────
# CRON_SESSION_FILE=data/cron-session.json
# USER_STORE_FILE=data/users.json
# Built SPA served at the single origin. Default resolves to ../frontend/dist.
# FRONTEND_DIST=/srv/fundsflee/frontend/dist
